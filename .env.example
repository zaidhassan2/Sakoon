# Groq model and API: https://console.groq.com/docs/models
# Free quotas vary by account: https://console.groq.com/docs/rate-limits
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
# Gemini alternative: LLM_PROVIDER=gemini and LLM_MODEL=gemini-3.8-flash
# https://ai.google.dev/gemini-api/docs/models
# https://ai.google.dev/gemini-api/docs/pricing
# Check your project's free availability/limits before use; do not enable billing.
GEMINI_API_KEY=
ALLOWED_ORIGIN=http://localhost:3000
DAILY_REQUEST_CAP=800
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Optional exception to no external storage: hashed quota counters only, with expiry.
# Free plan verified: https://upstash.com/pricing/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
